{
  "name": "agentkit-sdk",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Modular, secure, agent-agnostic TypeScript SDK for managing AI agents inside host applications",
  "keywords": ["ai", "agents", "sdk", "typescript"],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:node": "npm run test --workspaces --if-present -- --exclude=@agentkit/runtime-web",
    "test:browser": "cd packages/runtime-web && npm test",
    "test:all": "npm run test",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:observability": "node scripts/validate-observability.js",
    "validate:scripts": "node scripts/validate-package-scripts.js",
    "validate:tsconfig": "node scripts/validate-tsconfig.js",
    "validate:all": "npm run validate:scripts && npm run validate:tsconfig && npm run validate:observability",
    "build:npm": "./scripts/build-all.sh",
    "test:npm": "./scripts/test-all.sh",
    "typecheck:npm": "./scripts/typecheck.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}