{
  "name": "agentkit-sdk",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "description": "Modular, secure, agent-agnostic TypeScript SDK for managing AI agents inside host applications",
  "keywords": [
    "ai",
    "agents",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "test": "pnpm -r --parallel run test",
    "test:node": "pnpm -r --parallel --filter='!@agentkit/runtime-web' run test",
    "test:browser": "pnpm --filter @agentkit/runtime-web run test",
    "test:all": "pnpm test",
    "test:integration": "pnpm -C packages/sdk run test:integration",
    "clean": "pnpm -r --parallel run clean",
    "lint": "pnpm -r --parallel run lint",
    "typecheck": "pnpm -r --parallel run typecheck",
    "validate:observability": "node scripts/validate-observability.js",
    "validate:scripts": "node scripts/validate-package-scripts.js",
    "validate:tsconfig": "node scripts/validate-tsconfig.js",
    "validate:all": "pnpm validate:scripts && pnpm validate:tsconfig && pnpm validate:observability",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "size:check": "node scripts/size-check.js",
    "release:check": "node scripts/release-check.js",
    "release": "node scripts/release.js",
    "install:hooks": "./scripts/install-hooks.sh",
    "postinstall": "./scripts/install-hooks.sh",
    "cli": "node packages/cli/bin/agentkit.js",
    "agentkit": "node packages/cli/bin/agentkit.js",
    "analyze:deps": "./scripts/analyze-dependencies.sh",
    "madge:sdk": "madge --circular --extensions ts --warning packages/sdk/src",
    "madge:cli": "madge --circular --extensions ts --warning packages/cli/src",
    "madge:registry": "madge --circular --extensions ts --warning packages/registry/src",
    "madge:all": "pnpm analyze:deps"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "8.1.0",
    "@types/inquirer": "9.0.8",
    "@types/node": "^20.19.0",
    "@types/ora": "3.2.0",
    "@types/validate-npm-package-name": "4.0.2",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "madge": "^7.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}