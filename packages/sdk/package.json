{
  "name": "@agentkit/sdk",
  "version": "0.1.0-alpha",
  "description": "Core SDK for AgentKit",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentkit/registry": "workspace:*",
    "@agentkit/types": "workspace:*",
    "@agentkit/errors": "workspace:*"
  },
  "devDependencies": {
    "@agentkit/test-agent": "workspace:*",
    "@agentkit/transports-dummy": "workspace:*",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}