{
  "name": "@agentkit/sdk",
  "version": "0.1.0-alpha",
  "description": "Core SDK for AgentKit",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "npm run test:core",
    "test:watch": "vitest",
    "test:manual": "vitest test/manual/",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:core": "vitest run __tests__/connectAgent.test.ts __tests__/bounded-queue.test.ts __tests__/circuit-breaker.test.ts",
    "test:plugins": "vitest run __tests__/plugins/ __tests__/plugin-*.test.ts",
    "test:concurrency": "vitest run __tests__/agent-*concurrency*.test.ts __tests__/transport-*.test.ts",
    "test:observability": "vitest run __tests__/observability/ __tests__/metrics/",
    "test:legacy": "vitest run __tests__/legacy/",
    "test:all-batched": "npm run test:core && npm run test:plugins && npm run test:concurrency && npm run test:observability",
    "test:all": "node scripts/validate-tests.mjs && vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentkit/registry": "workspace:*",
    "@agentkit/types": "workspace:*",
    "@agentkit/errors": "workspace:*"
  },
  "devDependencies": {
    "@agentkit/test-agent": "workspace:*",
    "@agentkit/transports-dummy": "workspace:*",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}