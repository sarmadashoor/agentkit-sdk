{
  "name": "@agentkit/cli",
  "version": "0.1.0-alpha",
  "description": "AgentKit CLI for scaffolding plugins with excellent developer experience",
  "main": "dist/index.js",
  "bin": {
    "agentkit": "./bin/agentkit.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"templates/**/*\"",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "agentkit",
    "cli",
    "scaffold",
    "plugin",
    "developer-tools"
  ],
  "author": "AgentKit Team",
  "license": "MIT",
  "dependencies": {
    "@agentkit/types": "workspace:*",
    "@inquirer/prompts": "^3.3.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "ora": "^7.0.1",
    "validate-npm-package-name": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.4",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}