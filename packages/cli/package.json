{
  "name": "@agentkit/cli",
  "version": "0.1.0-alpha",
  "description": "AgentKit CLI for scaffolding plugins with excellent developer experience",
  "main": "dist/index.js",
  "bin": {
    "agentkit": "./bin/agentkit.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.4",
    "@types/readline-sync": "^1.4.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "tsup && cp dist/index-standalone.js bin/agentkit.js && chmod +x bin/agentkit.js",
    "dev": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}