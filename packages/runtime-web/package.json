{
  "name": "@agentkit/runtime-web",
  "version": "0.1.0-alpha",
  "description": "Browser runtime and transport for AgentKit SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:browser",
    "serve:test": "node tests/test-server.js",
    "validate:browser": "node validate-browser.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "browser",
    "transport",
    "mcp",
    "web",
    "fetch"
  ],
  "author": "AgentKit Team",
  "license": "MIT",
  "dependencies": {
    "@agentkit/types": "workspace:*",
    "@agentkit/errors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@playwright/test": "^1.40.0",
    "happy-dom": "^12.10.0"
  },
  "peerDependencies": {
    "@agentkit/sdk": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/agentkit-sdk.git",
    "directory": "packages/runtime-web"
  }
}